version: "3.9"

# GeoServer (Java/log4j) бусад сервисээс арай илүү дэлгэрэнгүй лог бичдэг тул
# арай өргөн (20MB × 5) хязгаар өгсөн — гэхдээ ямар ч тохиолдолд хязгааргүй биш.
x-logging: &default-logging
  driver: json-file
  options:
    max-size: "20m"
    max-file: "5"

services:
  geoserver:
    build:
      context: .
      dockerfile: Dockerfile
    environment:
      TZ: Asia/Ulaanbaatar
      # COG-ийн уншилтын БЛОКИЙН ХЭМЖЭЭ + heap.
      #
      # it.geosolutions.cog.default.header.length (imageio-ext-ийн анхдагч 16 KB)
      # нь зөвхөн толгойн хэмжээ БИШ — DefaultCogImageInputStream.read() нь
      # кэшлээгүй байт хэрэгтэй болоход ЯГ ЭНЭ ХЭМЖЭЭГЭЭР нэг HTTP Range
      # хүсэлт тавьдаг (fallback блок).
      #
      # ЯАГААД ЧУХАЛ: жинхэнэ COG-ийн IFD (толгой) файлын ЭХЭНД байдаг тул нэг
      # хүсэлтээр уншигдана. Харин ЖИРИЙН (COG биш) GeoTIFF-ийн IFD нь файлын
      # ТӨГСГӨЛД байх тул уншигч түүнд хүрэхийн тулд файлыг эхнээс дуустал
      # блок блокоор МӨЛХӨЖ уншина. 16 KB-аар 138 MB файл = 8831 хүсэлт ≈ 230-350
      # секунд (хэмжсэн). 1 MB болгоход ижил файл ~138 хүсэлт болж багасна.
      #
      # Xmx: мөлхөх уншилтын үед татсан блокууд ЦӨМ нь санах ойд хуримтлагддаг
      # (DefaultCogImageInputStream.data — close() хүртэл цэвэрлэгддэггүй).
      # Иймд COG биш том зураг heap-д бүтнээрээ орно — 1g хүрэлцэхгүй.
      EXTRA_JAVA_OPTS: >-
        -Xms512m -Xmx3g
        -Dit.geosolutions.cog.default.header.length=1048576
      GEOSERVER_ADMIN_USER: ${GEOSERVER_ADMIN:-admin}
      GEOSERVER_ADMIN_PASSWORD: ${GEOSERVER_PASS:-geoserver}
      GEOSERVER_DATA_DIR: /opt/geoserver_data
      # Татах ХЭРЭГГҮЙ: cog-http нь image дотор аль хэдийн байна
      # (Dockerfile build үед /opt/additional_libs-д хийсэн). Startup дээр
      # install-extensions.sh нь тэр zip-ийг зөвхөн unzip хийнэ.
      INSTALL_EXTENSIONS: "false"
      # COG — дроны ортофотог MinIO-с HTTP range-ээр шууд уншина
      STABLE_EXTENSIONS: "cog-http"
      COMMUNITY_EXTENSIONS: ""
    ports:
      - "${GEOSERVER_PORT:-8600}:8080"
    volumes:
      # Дроны ортофотог хуваалцсан хавтсаар БИШ, файлын системээс (MinIO)
      # HTTP Range-ээр ШУУД уншина (COG). Иймд bind mount шаардлагагүй —
      # GeoServer болон backend өөр сервер дээр ч байж болно.
      - geoserver_data:/opt/geoserver_data
    restart: on-failure
    logging: *default-logging
    networks:
      - gov_network

volumes:
  geoserver_data:

networks:
  gov_network:
    external: true
