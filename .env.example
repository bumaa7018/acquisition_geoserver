GEOSERVER_PORT=8600
GEOSERVER_ADMIN=admin
GEOSERVER_PASS=geoserver

# Backend DB (GeoServer-с холбогдох)
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=appdb

# ГУС (ЛМ) бүртгэлийн сан — data_landuse схемийн давхаргууд эндээс УНШИГДАНА
# (ca_agreed_parcel = шинэ зөвшилцсөн зураг, ca_sec_parcel = хамгаалалтын
# зурвас). Дундын сервисийн (goverment-middleware) AUTH_DB_* -тэй ИЖИЛ утга —
# ГУС руу нэмэлт эрх үүсгэхгүй, ЛМ-ээс хардаг эрхээрээ л уншина.
#
# Хоосон орхивол ГУС-ийн давхаргууд нийтлэгдэхгүй (локал орчинд хэвийн).
GUS_DB_HOST=
GUS_DB_PORT=5432
GUS_DB_USER=
GUS_DB_PASSWORD=
GUS_DB_NAME=
GUS_DB_SCHEMA=data_landuse
